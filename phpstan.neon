includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    level: max
    paths:
        - src
        - tests
    excludePaths:
        # Extends a missing class on purpose (SetProviderPass error reporting test)
        - tests/Fixtures/ProviderWithMissingParent.php
